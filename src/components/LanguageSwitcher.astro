---
import { getLocaleFromUrl, switchLocalePath, LANGUAGE_NAMES, LOCALES } from '../utils/i18n';

const { url } = Astro;
const currentLocale = getLocaleFromUrl(url);
---

<div class="language-switcher relative">
  <button
    class="language-toggle flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-foreground hover:text-highlight transition-colors"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span>{LANGUAGE_NAMES[currentLocale]}</span>
    <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div
    class="language-menu glass-panel absolute right-0 mt-5 w-24 rounded-lg opacity-0 invisible transition-all duration-200 z-50 p-1"
  >
    {LOCALES.map((locale) => (
      <a
        href={switchLocalePath(url.pathname, locale)}
        class={`block px-3 py-2 text-sm rounded-md transition-colors ${
          locale === currentLocale
            ? 'bg-accent font-semibold text-foreground'
            : 'text-muted-foreground hover:bg-muted hover:text-foreground'
        }`}
      >
        <div class="flex items-center">
          <span>{LANGUAGE_NAMES[locale]}</span>
          {locale === currentLocale && (
            <svg class="w-4 h-4 ml-auto" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
          )}
        </div>
      </a>
    ))}
  </div>
</div>

<script>
  // Language switcher functionality — class-based so multiple instances
  // (desktop header + mobile menu) work independently.
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.language-switcher').forEach((root) => {
      const toggle = root.querySelector<HTMLButtonElement>('.language-toggle');
      const menu = root.querySelector<HTMLDivElement>('.language-menu');
      if (!toggle || !menu) return;

      const setOpen = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        menu.classList.toggle('opacity-0', !open);
        menu.classList.toggle('invisible', !open);
        menu.classList.toggle('opacity-100', open);
        menu.classList.toggle('visible', open);
        const arrow = toggle.querySelector('svg');
        if (arrow) arrow.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
      };

      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      document.addEventListener('click', () => setOpen(false));
      menu.addEventListener('click', (e) => e.stopPropagation());
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
    });
  });
</script>
