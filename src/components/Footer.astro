---
import EmailFormModal from './EmailFormModal.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
import { getTranslation, localePath, type Locale } from '../utils/i18n';
import { CONTACT_EMAIL, LINKEDIN_COMPANY_URL, NAV_ITEMS } from '../utils/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const privacyHref = locale === 'nl' ? '/nl/privacy' : '/privacy';
---

<footer class="bg-brand-navy text-primary-foreground">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
		<div class="grid grid-cols-1 gap-10 md:grid-cols-3">
			<div>
				<div class="flex items-center gap-3">
					<img src="/gbs_logo.svg" alt="" class="h-9 w-9" />
					<span class="text-lg font-bold">Go be Smart</span>
				</div>
				<p class="mt-4 text-sm text-primary-foreground/70 max-w-xs">{t('common.footer.tagline')}</p>
			</div>

			<div>
				<h2 class="text-sm font-bold text-primary-foreground/90">{t('common.footer.navigation')}</h2>
				<ul class="mt-4 space-y-2.5">
					{NAV_ITEMS.map(({ key, path }) => (
						<li>
							<a
								href={localePath(locale, path)}
								class="text-sm text-primary-foreground/70 hover:text-primary-foreground transition-colors"
							>
								{t(`common.nav.${key}`)}
							</a>
						</li>
					))}
					<li>
						<button
							id="footer-newsletter-btn"
							class="text-sm text-primary-foreground/70 hover:text-primary-foreground transition-colors cursor-pointer"
						>
							{t('common.cta.stayUpdated')}
						</button>
					</li>
				</ul>
			</div>

			<div>
				<h2 class="text-sm font-bold text-primary-foreground/90">{t('common.footer.contact')}</h2>
				<ul class="mt-4 space-y-2.5">
					<li>
						<a
							href={`mailto:${CONTACT_EMAIL}`}
							class="text-sm text-primary-foreground/70 hover:text-primary-foreground transition-colors"
						>
							{CONTACT_EMAIL}
						</a>
					</li>
					<li>
						<a
							href={LINKEDIN_COMPANY_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-sm text-primary-foreground/70 hover:text-primary-foreground transition-colors"
						>
							<LinkedInIcon class="w-4 h-4" />
							{t('common.contact.linkedin')}
						</a>
					</li>
					<li class="text-sm text-primary-foreground/70">{t('common.contact.locationValue')}</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 flex flex-col gap-2 border-t border-primary-foreground/15 pt-6 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-xs text-primary-foreground/60">{t('common.footer.copyright')}</p>
			<a
				href={privacyHref}
				target="_blank"
				rel="noopener noreferrer"
				class="text-xs text-primary-foreground/60 underline hover:text-primary-foreground transition-colors"
			>
				{t('common.footer.privacy')}
			</a>
		</div>
	</div>
</footer>

<EmailFormModal t={t} />

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const btn = document.getElementById('footer-newsletter-btn');
		btn?.addEventListener('click', () => {
			(window as any).openEmailModal?.();
		});
	});
</script>
