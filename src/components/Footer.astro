---
import DemoFormModal from './DemoFormModal.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
import { getTranslation, localePath, type Locale } from '../utils/i18n';
import { CONTACT_EMAIL, LINKEDIN_COMPANY_URL, NAV_ITEMS } from '../utils/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const privacyHref = locale === 'nl' ? '/nl/privacy' : '/privacy';
---

<!-- One block: stamp + copyright anchor the left edge, navigation + contact
     anchor the right edge; tops and bottoms align across the block. -->
<footer class="bg-brand-navy text-primary-foreground">
	<div class="mx-auto flex max-w-6xl flex-col justify-between gap-8 px-4 py-10 sm:px-6 md:flex-row lg:px-8">
		<div class="flex flex-col justify-between gap-6">
			<a href={localePath(locale, '/')} aria-label="Go be Smart — home">
				<img src="/final_stamp_dark.svg" alt="Go be Smart" class="h-12 w-auto" />
			</a>
			<p class="text-xs text-primary-foreground/60">
				{t('common.footer.copyright')}
				<a
					href={privacyHref}
					target="_blank"
					rel="noopener noreferrer"
					class="ml-2 underline transition-colors hover:text-primary-foreground"
				>
					{t('common.footer.privacy')}
				</a>
			</p>
		</div>

		<div class="flex flex-col gap-8 sm:flex-row sm:gap-16">
			<div>
				<h2 class="text-sm font-bold text-primary-foreground/90">{t('common.footer.navigation')}</h2>
				<ul class="mt-3 space-y-1.5">
					{NAV_ITEMS.filter(({ key }) => key !== 'contact').map(({ key, path }) => (
						<li>
							<a
								href={localePath(locale, path)}
								class="text-sm text-primary-foreground/70 hover:text-primary-foreground transition-colors"
							>
								{t(`common.nav.${key}`)}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h2 class="text-sm font-bold">
					<a
						href={localePath(locale, '/contact')}
						class="text-primary-foreground/90 hover:text-primary-foreground transition-colors"
					>
						{t('common.footer.contact')}
					</a>
				</h2>
					<ul class="mt-3 space-y-1.5">
						<li>
							<a
								href={`mailto:${CONTACT_EMAIL}`}
								class="text-sm text-primary-foreground/70 hover:text-primary-foreground transition-colors"
							>
								{CONTACT_EMAIL}
							</a>
						</li>
						<li>
							<a
								href={LINKEDIN_COMPANY_URL}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 text-sm text-primary-foreground/70 hover:text-primary-foreground transition-colors"
							>
								<LinkedInIcon class="w-4 h-4" />
								{t('common.contact.linkedin')}
							</a>
						</li>
						<li class="text-sm text-primary-foreground/70">{t('common.contact.locationValue')}</li>
				</ul>
			</div>
		</div>
	</div>
</footer>

<!-- Mounted in the footer so the demo modal (and its hidden Netlify form)
     ships on every page; every [data-demo-trigger] button opens it. -->
<DemoFormModal t={t} />
