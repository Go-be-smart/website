---
interface Props {
	id?: string;
	class?: string;
	divider?: boolean;
}

const { id, class: className = '', divider = false } = Astro.props;
---

<section id={id} class={`relative py-20 md:py-28 ${divider ? 'border-t border-border' : ''} ${className}`}>
	<slot name="background" />
	<div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<slot />
	</div>
</section>
