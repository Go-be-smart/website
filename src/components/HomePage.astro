---
import LanguageSwitcher from './LanguageSwitcher.astro';
import EmailFormModal from './EmailFormModal.astro';
import { getLocaleFromUrl, getTranslation } from '../utils/i18n';

const { url } = Astro.props;
const currentLocale = getLocaleFromUrl(url);
const t = getTranslation(currentLocale);
---

<!-- Navigation -->
<nav class="fixed top-0 left-0 right-0 bg-[var(--color-bg-primary)]/95 backdrop-blur-sm border-b border-[var(--color-primary-dark)]/20 z-50">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between items-center py-4">
			<div class="flex items-center">
				<img src="/gbs_stamp_dark_no_bg.png" alt="Go be smart stamp" class="h-10" />
			</div>
			<div class="hidden md:flex space-x-8 items-center">
				<a href="#about" class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary-dark)] transition-colors">{t('nav.about')}</a>
				<a href="#team" class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary-dark)] transition-colors">{t('nav.team')}</a>
				<a href="#contact" class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary-dark)] transition-colors">{t('nav.contact')}</a>
			</div>
			<LanguageSwitcher />
		</div>
	</div>
</nav>

<!-- Hero Section -->
<section class="relative flex flex-col pt-20 pb-0 border-b border-[var(--color-primary-dark)]/30">
	<div class="blob-clip">
		<div class="ambient-blob ambient-blob--cyan" style="width: 480px; height: 480px; top: 180px; left: -140px;"></div>
		<div class="ambient-blob ambient-blob--blue" style="width: 520px; height: 520px; bottom: 120px; right: -160px;"></div>
		<div class="ambient-blob ambient-blob--accent" style="width: 360px; height: 360px; top: 450px; left: 55%;"></div>
	</div>
	<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center py-20">
			<h1 data-reveal="up" class="text-5xl md:text-6xl font-bold text-[var(--color-text-primary)] mb-6">
				{t('hero.title')}
				<span class="bg-gradient-to-r from-[var(--color-gradient-start)] to-[var(--color-gradient-end)] bg-clip-text text-transparent">
					{t('hero.titleHighlight')}
				</span>
			</h1>
			<p data-reveal="up" style="--reveal-delay: 120ms;" class="text-xl text-[var(--color-text-secondary)] mb-8 max-w-3xl mx-auto">
				{t('hero.description')}
			</p>
			<div data-reveal="up" style="--reveal-delay: 240ms;" class="flex gap-4 justify-center">
				<button
					id="openModalBtn"
					class="bg-gradient-to-r from-[var(--color-gradient-start)] to-[var(--color-gradient-end)] text-[var(--color-text-primary)] px-8 py-4 rounded-lg text-lg font-semibold hover:shadow-xl hover:shadow-[var(--color-primary-dark)]/30 transition-all transform hover:scale-105"
				>
					{t('hero.learnMore')}
				</button>
				<a
					href="https://app.gobesmart.io"
					target="_blank"
					rel="noopener noreferrer"
					class="bg-transparent border-2 border-[var(--color-primary-dark)] text-[var(--color-primary)] px-8 py-4 rounded-lg text-lg font-semibold hover:bg-[var(--color-primary-dark)]/10 hover:shadow-xl hover:shadow-[var(--color-primary-dark)]/30 transition-all transform hover:scale-105"
				>
					{t('hero.requestDemo')}
				</a>
			</div>
		</div>
	</div>
</section>

<!-- About Section -->
<section id="about" class="relative flex flex-col py-20 border-b border-[var(--color-primary-dark)]/20">
	<div class="blob-clip">
		<div class="ambient-blob ambient-blob--accent" style="width: 340px; height: 340px; top: 220px; left: 8%; opacity: 0.12;"></div>
		<div class="ambient-blob ambient-blob--cyan" style="width: 400px; height: 400px; bottom: 160px; right: -120px; opacity: 0.10;"></div>
	</div>
	<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid md:grid-cols-2 gap-12 items-center">
			<div data-reveal="left">
				<h3 class="text-2xl font-bold text-[var(--color-primary)] mb-4"><span class="bg-gradient-to-r from-[var(--color-gradient-start)] to-[var(--color-gradient-end)] bg-clip-text text-transparent">
					{t('about.title')}
				</span></h3>
				<p class="text-[var(--color-text-secondary)] mb-6">
					{t('about.description')}
				</p>
				<div class="space-y-4">
					<div class="flex items-center">
						<div class="w-3 h-3 bg-gradient-to-r from-[var(--color-gradient-start)] to-[var(--color-gradient-end)] rounded-full mr-3"></div>
						<span class="text-[var(--color-text-secondary)]">{t('about.features.commissioning')}</span>
					</div>
					<div class="flex items-center">
						<div class="w-3 h-3 bg-gradient-to-r from-[var(--color-gradient-start)] to-[var(--color-gradient-end)] rounded-full mr-3"></div>
						<span class="text-[var(--color-text-secondary)]">{t('about.features.support')}</span>
					</div>
					<div class="flex items-center">
						<div class="w-3 h-3 bg-gradient-to-r from-[var(--color-gradient-start)] to-[var(--color-gradient-end)] rounded-full mr-3"></div>
							<span class="text-[var(--color-text-secondary)]">{t('about.features.control')}</span>
						</div>
				</div>
			</div>
			<div data-reveal="right" style="--reveal-delay: 100ms;" class="h-[270px] flex justify-center items-center">
				<img src="/dashboard_no_border.png" alt="Dashboard Preview" class="h-full object-cover rounded-lg shadow-lg shadow-[var(--color-primary-dark)]">
			</div>
		</div>
	</div>
</section>


<!-- Team Section -->
<section id="team" class="relative flex flex-col py-20 border-b border-[var(--color-primary-dark)]/30">
	<div class="blob-clip">
		<div class="ambient-blob ambient-blob--blue" style="width: 380px; height: 380px; top: 180px; left: 32%; opacity: 0.2;"></div>
		<div class="ambient-blob ambient-blob--accent" style="width: 300px; height: 300px; bottom: 220px; left: 4%; opacity: 0.15;"></div>
	</div>
	<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-36 lg:gap-48 items-start">
			<div data-reveal="up" class="text-center flex flex-col h-full transition-transform duration-300 hover:-translate-y-1">
				<img
					src="/keje_red_blue.png"
					alt="Team member portrait: Keje"
					class="w-36 h-36 md:w-44 md:h-44 rounded-full object-cover mx-auto shadow-lg shadow-[var(--color-primary-dark)]/30 ring-2 ring-[var(--color-primary-dark)]/20"
					loading="lazy"
				/>
				<h3 class="mt-6 text-xl font-semibold text-[var(--color-text-primary)]">Keje Sinnige</h3>
				<p class="mt-2 text-[var(--color-text-secondary)] w-45 mx-auto text-center flex-grow">
					{t('team.descriptions.keje')}
				</p>
				<a
					href="https://www.linkedin.com/in/keje-sinnige/"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center mt-4 w-8 h-8 mx-auto text-[var(--color-text-secondary)] hover:text-[var(--color-primary-dark)] transition-colors"
					aria-label="Keje Sinnige's LinkedIn profile"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</a>
			</div>

			<div data-reveal="up" style="--reveal-delay: 120ms;" class="text-center flex flex-col h-full transition-transform duration-300 hover:-translate-y-1">
				<img
					src="/charlie_red_blue_wide.png"
					alt="Team member portrait: Charlie"
					class="w-36 h-36 md:w-44 md:h-44 rounded-full object-cover mx-auto shadow-lg shadow-[var(--color-primary-dark)]/30 ring-2 ring-[var(--color-primary-dark)]/20"
					loading="lazy"
				/>
				<h3 class="mt-6 text-xl font-semibold text-[var(--color-text-primary)]">Charlie Zinken</h3>
				<p class="mt-2 text-[var(--color-text-secondary)] w-45 mx-auto text-center flex-grow">
					{t('team.descriptions.charlie')}
				</p>
				<a
					href="https://www.linkedin.com/in/charlie-zinken-04a3a286/"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center mt-4 w-8 h-8 mx-auto text-[var(--color-text-secondary)] hover:text-[var(--color-primary-dark)] transition-colors"
					aria-label="Charlie Zinken's LinkedIn profile"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</a>
			</div>

			<div data-reveal="up" style="--reveal-delay: 240ms;" class="text-center flex flex-col h-full transition-transform duration-300 hover:-translate-y-1">
				<img
					src="/age.png"
					alt="Team member portrait: Age"
					class="w-36 h-36 md:w-44 md:h-44 rounded-full object-cover mx-auto shadow-lg shadow-[var(--color-primary-dark)]/30 ring-2 ring-[var(--color-primary-dark)]/20"
					loading="lazy"
				/>
				<h3 class="mt-6 text-xl font-semibold text-[var(--color-text-primary)]">Age Tjalma</h3>
				<p class="mt-2 text-[var(--color-text-secondary)] w-45 mx-auto text-center flex-grow">
					{t('team.descriptions.age')}
				</p>
				<a
					href="https://www.linkedin.com/in/agetjalma/"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center mt-4 w-8 h-8 mx-auto text-[var(--color-text-secondary)] hover:text-[var(--color-primary-dark)] transition-colors"
					aria-label="Age Tjalma's LinkedIn profile"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</a>
			</div>
		</div>
	</div>
</section>


<!-- Contact Section -->
<section id="contact" class="relative flex flex-col pb-12 pt-16">
	<div class="blob-clip" style="bottom: 0;">
		<div class="ambient-blob ambient-blob--cyan" style="width: 320px; height: 320px; top: 220px; right: 12%; opacity: 0.09;"></div>
	</div>
	<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col mx-auto w-full">
			<p data-reveal="fade" class="text-xl text-[var(--color-text-secondary)] text-center mb-4">
				{t('contact.description')}
			</p>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 max-w-5xl mx-auto w-full">
				<!-- LinkedIn -->
				<a
					data-reveal="left"
					href="https://www.linkedin.com/company/go-be-smart/"
					target="_blank"
					rel="noopener noreferrer"
					class="group flex flex-col items-center text-center p-6 rounded-lg hover:bg-[var(--color-bg-secondary)]/50 transition-all duration-300"
					aria-label="Go be smart LinkedIn company page"
				>
					<div class="w-12 h-12 flex items-center justify-center mb-2 text-[var(--color-text-secondary)] group-hover:text-[var(--color-primary-dark)] transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</div>
					<p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text-secondary)] transition-colors">{t('contact.linkedin')}</p>
				</a>

				<!-- Email -->
				<a
					data-reveal="fade"
					style="--reveal-delay: 100ms;"
					href="mailto:info@gobesmart.nl"
					class="group flex flex-col items-center text-center p-6 rounded-lg hover:bg-[var(--color-bg-secondary)]/50 transition-all duration-300"
				>
					<div class="w-12 h-12 flex items-center justify-center mb-2 text-[var(--color-text-secondary)] group-hover:text-[var(--color-primary-dark)] transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
							<polyline points="22,6 12,13 2,6"></polyline>
						</svg>
					</div>
					<p class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text-secondary)] transition-colors break-all">info@gobesmart.nl</p>
				</a>

				<!-- Location -->
				<div data-reveal="right" style="--reveal-delay: 200ms;" class="flex flex-col items-center text-center p-6 rounded-lg">
					<div class="w-12 h-12 flex items-center justify-center mb-2 text-[var(--color-text-secondary)]">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8">
							<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
							<circle cx="12" cy="10" r="3"></circle>
						</svg>
					</div>
					<p class="text-sm text-[var(--color-text-muted)]">{t('contact.locationValue')}</p>
				</div>
			</div>
		</div>
	</div>
</section>


<!-- Footer -->
<footer class={`bg-[var(--color-bg-dark)] text-[var(--color-text-primary)] py-12 border-t border-[var(--color-primary-dark)]/20 text-center`}>
			<p class={`text-[var(--color-text-muted)] text-sm`}>
				{t('footer.copyright')}
				<a
				href={currentLocale === 'nl' ? '/nl/privacy' : '/privacy'}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-2 inline-block text-[var(--color-text-muted)] text-sm hover:text-[var(--color-primary-dark)] transition-colors underline"
			>
				{t('footer.privacy')}
			</a>
			</p>
</footer>

<!-- Email Form Modal Component -->
<EmailFormModal t={t} />

<script>
	// Attach event listener to open modal button
	document.addEventListener('DOMContentLoaded', () => {
		const openBtn = document.getElementById('openModalBtn');
		if (openBtn && typeof (window as any).openEmailModal === 'function') {
			openBtn.addEventListener('click', () => {
				(window as any).openEmailModal();
			});
		}
	});
</script>