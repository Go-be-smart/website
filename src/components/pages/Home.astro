---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Hero from '../sections/home/Hero.astro';
import What from '../sections/home/What.astro';
import Why from '../sections/home/Why.astro';
import Pricing from '../sections/home/Pricing.astro';
import ClosingCta from '../sections/shared/ClosingCta.astro';
import { type Locale } from '../../utils/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<Header locale={locale} />
<main>
	<Hero locale={locale} />
	<Why locale={locale} />
	<What locale={locale} />
	<Pricing locale={locale} />
	<ClosingCta locale={locale} />
</main>
<Footer locale={locale} />
