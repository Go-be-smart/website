---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Section from '../ui/Section.astro';
import FeatureRow from '../sections/product/FeatureRow.astro';
import Faq from '../sections/product/Faq.astro';
import ClosingCta from '../sections/shared/ClosingCta.astro';
import { getTranslation, getListTranslation, type Locale } from '../../utils/i18n';
import settingsShot from '../../assets/screenshot_settings.png';
import maintenanceShot from '../../assets/screenshot_maintenance.png';
import fleetAuditShot from '../../assets/screenshot_fleet_audit.png';
import dataShot from '../../assets/screenshot_data_nobrand.png';
import advancedChartsShot from '../../assets/screenshot_advanced_charts.png';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const tList = getListTranslation(locale);

// anchor = the id the homepage feature circles link to.
// Order: fundamentals (commissioning, maintenance, fleet), then nice-to-haves.
const features = [
	{ key: 'commissioning', anchor: 'commissioning', image: settingsShot },
	{ key: 'monitoring', anchor: 'maintenance', image: maintenanceShot },
	{ key: 'fleet', anchor: 'fleet', image: advancedChartsShot },
	{ key: 'ai', anchor: 'support', image: fleetAuditShot },
	{ key: 'control', anchor: 'control', image: dataShot },
];
---

<Header locale={locale} />
<main>
	<Section class="!py-16 md:!py-20">
		<div class="max-w-3xl" data-reveal="up">
			<h1 class="text-4xl font-semibold tracking-tight text-foreground md:text-5xl">
				{t('product.hero.title')}
			</h1>
			<p class="mt-6 text-lg text-muted-foreground md:text-xl">{t('product.hero.description')}</p>
		</div>
	</Section>

	<Section divider>
		<div class="space-y-20 md:space-y-28">
			{features.map(({ key, anchor, image }, i) => (
				<FeatureRow
					id={anchor}
					title={t(`product.features.${key}.title`)}
					description={t(`product.features.${key}.description`)}
					bullets={tList(`product.features.${key}.bullets`)}
					image={image}
					imageAlt={t(`product.features.${key}.title`)}
					flip={i % 2 === 1}
				/>
			))}
		</div>
	</Section>

	<Faq locale={locale} />

	<ClosingCta locale={locale} />
</main>
<Footer locale={locale} />
