---
import Section from '../../ui/Section.astro';
import { getTranslation, localePath, type Locale } from '../../../utils/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);

const questions = ['connect', 'brands', 'residents', 'servicing', 'settings', 'data'];
---

<Section divider>
	<h2 class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl" data-reveal="up">
		{t('product.faq.title')}
	</h2>
	<div class="mt-10 divide-y divide-border border-y border-border" data-reveal="up">
		{questions.map((key) => (
			<details class="group">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-foreground [&::-webkit-details-marker]:hidden">
					{t(`product.faq.items.${key}.question`)}
					<svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
					</svg>
				</summary>
				<p class="pb-6 pr-8 text-base text-muted-foreground">{t(`product.faq.items.${key}.answer`)}</p>
			</details>
		))}
	</div>
	<p class="mt-10 text-base text-muted-foreground" data-reveal="up">
		{t('product.faq.more')}
		<a href={localePath(locale, '/contact')} class="font-medium text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-highlight">
			{t('common.cta.contactUs')}
		</a>
	</p>
</Section>
