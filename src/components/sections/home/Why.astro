---
import Section from '../../ui/Section.astro';
import { getTranslation, type Locale } from '../../../utils/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
---

<!-- The problem statement: one large text block, resolved by the navy
     What-band directly below ("One platform for heat pump management"). -->
<Section class="!pt-30 !pb-30 md:!pt-40 md:!pb-40">
	<p class="max-w-4xl text-2xl font-medium leading-snug tracking-tight md:text-4xl" data-reveal="up">
		<span class="text-foreground">{t('home.why.statement.lead')}</span>
		<span class="text-foreground/55">{t('home.why.statement.middle')}</span>
		<span class="marker-coral text-foreground">{t('home.why.statement.punch')}</span>
	</p>
</Section>

<style>
	/* Soft marker wash behind the punch line; clone keeps the wash intact
	   when the phrase wraps across lines. */
	.marker-coral {
		background-color: oklch(0.9 0.055 30 / 0.55);
		border-radius: 0.25em;
		padding: 0.05em 0.18em;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}
</style>
