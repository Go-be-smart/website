---
import Button from '../../ui/Button.astro';
import { getTranslation, type Locale } from '../../../utils/i18n';
import { BOOK_DEMO_URL } from '../../../utils/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
---

<div class="px-3 pt-3 sm:px-4">
	<div class="hero-gradient bg-grid relative overflow-hidden rounded-3xl">
		<div
			class="mx-auto grid max-w-6xl items-center gap-14 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-[1.15fr_1fr] lg:gap-12 lg:px-8"
		>
			<div class="text-center lg:text-left">
				<h1
					data-reveal="up"
					class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight text-foreground sm:text-5xl md:text-6xl lg:mx-0"
				>
					{t('home.hero.title')}
				</h1>
				<p
					data-reveal="up"
					style="--reveal-delay: 120ms;"
					class="mx-auto mt-6 max-w-2xl text-lg text-foreground/75 md:text-xl lg:mx-0"
				>
					{t('home.hero.description')}
				</p>
				<div data-reveal="up" style="--reveal-delay: 240ms;" class="mt-9">
					<Button href={BOOK_DEMO_URL} data-demo-trigger>{t('common.cta.bookDemo')}</Button>
				</div>
			</div>

			<!-- Detect → act → healthy: one push-notification at a time, looping. -->
			<div class="flow-stack mx-auto w-full max-w-[21rem] lg:mx-0 lg:justify-self-end" data-reveal="fade" style="--reveal-delay: 320ms;">
				<div class="flow-card flow-card--short" style="--toast-delay: 0s;">
					<span class="absolute top-3.5 right-3.5 text-foreground/30" aria-hidden="true">
						<svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
						</svg>
					</span>
					<span class="flow-time absolute top-[15px] right-10 text-[11px] leading-none text-muted-foreground" data-offset-min="-3"></span>
					<div>
						<p class="flex items-center gap-2.5 text-sm font-semibold text-foreground">
							<span class="size-2.5 shrink-0 rounded-full bg-brand-coral"></span>
							{t('home.hero.cards.alert')}
						</p>
						<p class="mt-1.5 pl-5 text-xs text-muted-foreground">{t('home.hero.cards.alertDetail')}</p>
					</div>
				</div>
				<div class="flow-card flow-card--short" style="--toast-delay: 3s;">
					<span class="absolute top-3.5 right-3.5 text-foreground/30" aria-hidden="true">
						<svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
						</svg>
					</span>
					<span class="flow-time absolute top-[15px] right-10 text-[11px] leading-none text-muted-foreground" data-offset-min="-2"></span>
					<div>
						<p class="flex items-center gap-2.5 text-sm font-semibold text-foreground">
							<span class="size-2.5 shrink-0 rounded-full bg-brand-sky"></span>
							{t('home.hero.cards.action')}
						</p>
						<p class="mt-1.5 pl-5 text-xs text-muted-foreground">{t('home.hero.cards.actionDetail')}</p>
					</div>
				</div>
				<div class="flow-card flow-card--long" style="--toast-delay: 6s;">
					<span class="absolute top-3.5 right-3.5 text-foreground/30" aria-hidden="true">
						<svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
						</svg>
					</span>
					<span class="flow-time absolute top-[15px] right-10 text-[11px] leading-none text-muted-foreground" data-offset-min="0"></span>
					<div>
						<p class="flex items-center gap-2.5 text-sm font-semibold text-foreground">
							<span class="size-2.5 shrink-0 rounded-full bg-[#0d8a6d]"></span>
							{t('home.hero.cards.resolved')}
						</p>
						<p class="mt-1.5 pl-5 text-xs text-muted-foreground">{t('home.hero.cards.resolvedDetail')}</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	/* Sky-tinted glass: the cool counterweight to the warm hero panel. The panel's
	   gradient bleeds through the translucent fill, so the cards pick up a hint of
	   the header's coral→sky atmosphere for free. */
	/* All three cards share one grid cell; the animation shows one at a time. */
	.flow-stack {
		display: grid;
	}
	.flow-stack > .flow-card {
		grid-area: 1 / 1;
		z-index: 1;
	}
	/* The "next notification" peeking out from behind the active card */
	.flow-stack::after {
		content: '';
		grid-area: 1 / 1;
		z-index: 0;
		transform: translateY(0.9rem) scale(0.94);
		border-radius: 1.25rem;
		background-color: oklch(0.99 0 0 / 0.1);
		backdrop-filter: blur(12px);
		box-shadow: 0 10px 22px -10px oklch(0.32 0.05 250 / 0.14);
	}

	.flow-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 0.875rem;
		min-height: 9rem;
		padding: 1.25rem 1.375rem;
		border-radius: 1.25rem;
		background-color: oklch(0.99 0 0 / 0.9);
		backdrop-filter: blur(18px);
		border: 0px solid oklch(1 0 0 / 0.5);
		box-shadow:
			inset 0 1px 0 0 oklch(1 0 0 / 0.4),
			0 12px 28px -8px oklch(0.32 0.05 250 / 0.18);
		opacity: 0;
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
		animation-fill-mode: both;
		animation-duration: 10s;
		animation-delay: var(--toast-delay, 0s);
	}
	.flow-card--short {
		animation-name: toast-short;
	}
	.flow-card--long {
		animation-name: toast-long;
	}

	/* Push-notification lifecycle: pop in with a slight overshoot, hold, then
	   drift up and fade as the next one arrives. 10s cycle: 3s + 3s + 4s, so
	   the resolved state lingers longest. */
	@keyframes toast-short {
		0% {
			opacity: 0;
			transform: translateY(18px) scale(0.96);
		}
		3.5% {
			opacity: 1;
			transform: translateY(-3px) scale(1.01);
		}
		5% {
			transform: translateY(0) scale(1);
		}
		25% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
		30% {
			opacity: 0;
			transform: translateY(-14px) scale(0.985);
		}
		100% {
			opacity: 0;
			transform: translateY(-14px) scale(0.985);
		}
	}
	@keyframes toast-long {
		0% {
			opacity: 0;
			transform: translateY(18px) scale(0.96);
		}
		3.5% {
			opacity: 1;
			transform: translateY(-3px) scale(1.01);
		}
		5% {
			transform: translateY(0) scale(1);
		}
		35% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
		40% {
			opacity: 0;
			transform: translateY(-14px) scale(0.985);
		}
		100% {
			opacity: 0;
			transform: translateY(-14px) scale(0.985);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flow-stack {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}
		.flow-stack::after {
			display: none;
		}
		.flow-card {
			animation: none;
			opacity: 1;
		}
	}
</style>

<script>
	// Real clock time in the notification stamps: the alert "arrived" a few
	// minutes ago, the resolution just now. Browser locale decides 12h/24h.
	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll<HTMLElement>('.flow-time').forEach((el) => {
			const offsetMin = Number(el.dataset.offsetMin || '0');
			const d = new Date(Date.now() + offsetMin * 60_000);
			el.textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
		});
	});
</script>
