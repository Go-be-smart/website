---
import Layout from '../layouts/Layout.astro';
import Product from '../components/pages/Product.astro';
import { getLocaleFromUrl, getTranslation } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslation(locale);
---

<Layout locale={locale} title={t('product.meta.title')} description={t('product.meta.description')}>
	<Product locale={locale} />
</Layout>
