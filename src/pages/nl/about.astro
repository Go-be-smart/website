---
import Layout from '../../layouts/Layout.astro';
import About from '../../components/pages/About.astro';
import { getLocaleFromUrl, getTranslation } from '../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslation(locale);
---

<Layout locale={locale} title={t('about.meta.title')} description={t('about.meta.description')}>
	<About locale={locale} />
</Layout>
